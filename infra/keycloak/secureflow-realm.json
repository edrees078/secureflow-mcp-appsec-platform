{
  "realm": "secureflow",
  "enabled": true,
  "displayName": "SecureFlow Application Security Platform",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "secureflow-bff",
      "name": "SecureFlow BFF Client",
      "description": "Confidential BFF client for SecureFlow web and API authentication",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5173/login##http://localhost:5173/login##http://127.0.0.1:3000/login##http://localhost:3000/login"
      },
      "redirectUris": [
        "http://127.0.0.1:3000/api/v1/auth/callback",
        "http://localhost:3000/api/v1/auth/callback",
        "http://127.0.0.1:5173/api/v1/auth/callback",
        "http://localhost:5173/api/v1/auth/callback",
        "http://127.0.0.1:5173/auth/callback",
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000",
        "http://localhost:3000",
        "http://127.0.0.1:5173",
        "http://localhost:5173"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "SecureFlow Global Admin"
      },
      {
        "name": "ANALYST",
        "description": "SecureFlow Security Analyst"
      },
      {
        "name": "DEVELOPER",
        "description": "SecureFlow Remediation Developer"
      },
      {
        "name": "USER",
        "description": "SecureFlow Ordinary User"
      }
    ]
  },
  "users": [
    {
      "username": "admin@secureflow.example",
      "email": "admin@secureflow.example",
      "firstName": "System",
      "lastName": "Administrator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEV_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "USER"
      ]
    },
    {
      "username": "analyst@secureflow.example",
      "email": "analyst@secureflow.example",
      "firstName": "Alice",
      "lastName": "Analyst",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEV_ANALYST_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ANALYST",
        "USER"
      ]
    },
    {
      "username": "dev@secureflow.example",
      "email": "dev@secureflow.example",
      "firstName": "Bob",
      "lastName": "Developer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEV_DEVELOPER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "DEVELOPER",
        "USER"
      ]
    }
  ]
}
