{
  "name": "@secureflow/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./services/*": {
      "types": "./dist/services/*.d.ts",
      "import": "./dist/services/*.js"
    }
  },
  "dependencies": {
    "@secureflow/schemas": "workspace:*",
    "@secureflow/shared": "workspace:*",
    "pg": "^8.23.1"
  },
  "scripts": {
    "build": "tsc -b",
    "db:smoke": "tsx src/db/smoke-check.ts",
    "db:test:integrity": "tsx tests/integration/db-integrity.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "16.4.7",
    "prisma": "7.10.1"
  }
}
