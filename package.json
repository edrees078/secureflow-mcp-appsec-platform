{
  "name": "secureflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "SecureFlow — Security Findings & Remediation Management Platform with Model Context Protocol (MCP)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  },
  "scripts": {
    "build": "pnpm run prisma:generate && tsc -b",
    "clean": "tsc -b --clean",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:smoke": "tsx packages/domain/src/db/smoke-check.ts",
    "db:status": "docker compose ps",
    "db:test:integrity": "pnpm --filter @secureflow/domain run db:test:integrity",
    "db:up": "docker compose up -d",
    "db:validate": "node scripts/validate-compose.mjs",
    "dev:api": "pnpm --filter @secureflow/api dev",
    "lint": "eslint .",
    "prisma:generate": "pnpm --filter @secureflow/domain run prisma:generate",
    "prisma:validate": "pnpm --filter @secureflow/domain exec prisma validate",
    "test": "pnpm run test:boundaries && pnpm run test:api",
    "test:api": "pnpm --filter @secureflow/api test",
    "test:boundaries": "node tests/boundaries/verify-boundaries.mjs",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
