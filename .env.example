# ==============================================================================
# SecureFlow — Root Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' at the repository root before starting local services:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# SECURITY RULES:
# 1. The active '.env' file is ignored by Git and must NEVER be committed.
# 2. Never use default development credentials in staging or production.
# 3. All passwords should be generated using strong entropy (min 32 characters).
# 4. Host port 5433 is used to isolate Docker PostgreSQL 17 from any native
#    PostgreSQL 15 installation running on Windows host port 5432.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Docker Compose & Container Initialization)
# NOTE: POSTGRES_PASSWORD value below is a development-only placeholder.
# ------------------------------------------------------------------------------
POSTGRES_USER=secureflow
POSTGRES_PASSWORD=secureflow_dev_password_change_me
POSTGRES_DB=secureflow_dev
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# Prisma ORM 7 Connection URL
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Used by packages/domain/prisma.config.ts and database clients
# NOTE: Connects via Windows host port 5433 to Docker PostgreSQL 17.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://secureflow:secureflow_dev_password_change_me@127.0.0.1:5433/secureflow_dev?schema=public

# ------------------------------------------------------------------------------
# Node Environment Runtime Setting
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Integration Test Database URL
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Strictly isolated to secureflow_test on host port 5433 (PostgreSQL 17).
# ------------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://secureflow:secureflow_dev_password_change_me@127.0.0.1:5433/secureflow_test?schema=public

# ------------------------------------------------------------------------------
# API Server & Frontend Origin Configuration (Local Loopback Hostname: 127.0.0.1)
# Keep consistent loopback hostname (127.0.0.1) across Vite, BFF, and Keycloak.
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://127.0.0.1:5173
AUTH_ENABLED=true

# ------------------------------------------------------------------------------
# Local Keycloak IAM & OIDC BFF Authentication (Docker Compose Loopback)
# Generate unique CSPRNG values in local gitignored .env; never commit real secrets.
# ------------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=keycloak_admin_change_me
KEYCLOAK_ADMIN_PASSWORD=replace_with_generated_admin_password_change_me
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/secureflow
OIDC_CLIENT_ID=secureflow-bff
OIDC_CLIENT_SECRET=replace_with_generated_client_secret_change_me
OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/callback
OIDC_ALLOWED_REDIRECT_URIS=http://127.0.0.1:3000/api/v1/auth/callback,http://localhost:3000/api/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5173/login
OIDC_ALLOWED_POST_LOGOUT_REDIRECT_URIS=http://127.0.0.1:5173/login,http://localhost:5173/login
KEYCLOAK_DEV_ADMIN_PASSWORD=replace_with_generated_dev_admin_password_change_me
KEYCLOAK_DEV_ANALYST_PASSWORD=replace_with_generated_dev_analyst_password_change_me
KEYCLOAK_DEV_DEVELOPER_PASSWORD=replace_with_generated_dev_developer_password_change_me
