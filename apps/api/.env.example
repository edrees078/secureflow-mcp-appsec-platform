# SecureFlow API Environment Variables
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
AUTH_ENABLED=false
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/secureflow
OIDC_CLIENT_ID=secureflow-bff
OIDC_CLIENT_SECRET=replace_with_generated_client_secret_change_me
OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/callback
OIDC_ALLOWED_REDIRECT_URIS=http://127.0.0.1:3000/api/v1/auth/callback,http://localhost:3000/api/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5173/login
OIDC_ALLOWED_POST_LOGOUT_REDIRECT_URIS=http://127.0.0.1:5173/login,http://localhost:5173/login
